# Public project endpoint/key; never use service_role here.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
# A separate Supabase Auth account restricted to the device role by devices table.
SUPABASE_DEVICE_EMAIL=pos@example.invalid
SUPABASE_DEVICE_PASSWORD=SET-LOCALLY-ONLY
CAFE_ID=YOUR-CAFE-UUID
DEVICE_ID=YOUR-REGISTERED-DEVICE-UUID
